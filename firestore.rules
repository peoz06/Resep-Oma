rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      // Sesi anonymous tetap tamu; token tersebut tidak memberi akses ke koleksi privat.
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        // Akun lama tanpa status tetap aktif; dokumen yang hilang tidak mendapat izin.
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    function admin() {
      // Role dipercaya dari profil server; admin pertama harus diatur manual lewat Console.
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function publicRecipe(data) {
      // Whitelist ini bukan penyaring data pribadi di teks bebas, URL, atau isi nested.
      return data.keys().hasOnly([
        'code', 'title', 'description', 'category', 'filterKey', 'cookTime',
        'servings', 'difficulty', 'image', 'images', 'authorId', 'authorName',
        'authorAvatar', 'likesCount', 'recooksCount', 'reportedCount', 'verified',
        'status', 'ingredients', 'steps', 'createdAt', 'updatedAt'
      ])
        && data.authorId is string && data.authorName is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 60
        && data.image is string && data.ingredients is list && data.steps is list;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if activeUser()
        && request.resource.data.authorId == request.auth.uid
        && publicRecipe(request.resource.data);
      allow update: if publicRecipe(request.resource.data) && (
        admin() || (
          activeUser() && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'category', 'filterKey', 'cookTime', 'servings',
            'difficulty', 'image', 'images', 'ingredients', 'steps', 'updatedAt'
          ])
        )
      );
      allow delete: if admin() || (activeUser() && resource.data.authorId == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'status', 'avatar', 'provider', 'code',
          'pending', 'createdAt', 'updatedAt'
        ]) && (
          (request.auth.uid == uid && request.resource.data.role == 'user'
            && request.resource.data.status == 'active'
            && request.resource.data.get('pending', false) == false)
          || (admin() && request.auth.uid != uid
            && request.resource.data.role == 'user'
            && request.resource.data.status == 'baru'
            && request.resource.data.pending == true)
        );
      allow update: if signedIn() && (
        (request.auth.uid == uid && activeUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'avatar', 'updatedAt']))
        || (admin() && request.auth.uid != uid
          && request.resource.data.get('role', 'user') in ['user', 'creator', 'admin']
          && request.resource.data.get('status', 'active') in ['active', 'suspended', 'banned', 'baru'])
      );
      // Tidak ada delete: status banned mempertahankan identitas dan riwayat moderasi.
    }

    match /favorites/{favId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/favorites/$(favId))
        || resource.data.uid == request.auth.uid
      );
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.recipeId is string
        && favId == request.auth.uid + '__' + request.resource.data.recipeId
        && request.resource.data.keys().hasOnly(['uid', 'recipeId', 'createdAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.recipeId == resource.data.recipeId
        && request.resource.data.keys().hasOnly(['uid', 'recipeId', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.keys().hasOnly([
          'recipeId', 'recipeTitle', 'reporterId', 'reporterName', 'reason', 'status', 'createdAt'
        ]);
      allow read, update, delete: if admin();
    }
  }
}
